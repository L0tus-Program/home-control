{
  "name": "home-control",
  "version": "0.1.0",
  "description": "Central de automação da casa — LG ThinQ e Tuya",
  "main": "./out/main/index.js",
  "author": "Felipe",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "mqtt": "^5.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "io.github.l0tus-program.homecontrol",
    "productName": "Home Control",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
